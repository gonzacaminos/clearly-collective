{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="page-width">
    <div
      class="tw-flex tw-justify-center splide splide-slider"
      aria-labelledby="carousel-heading"
      data-per-page="1">

      <div
        class="scroll-trigger animate--fade-in"
        aria-live="polite"
        aria-atomic="true">
        <div class="splide__track">
          <ul class="splide__list">
            {%- for block in section.blocks -%}

              <li
                class="splide__slide tw-w-full tw-relative tw-z-50"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1">
                <div class="tw-grid lg:tw-grid-cols-2 tw-items-center">
                  {% if block.settings.image %}
                    <div>
                      {{ block.settings.image | image_url: height: image.height | image_tag: class: 'tw-aspect-square lg:tw-aspect-auto tw-object-cover' }}
                    </div>
                  {% endif %}
                  <div class="tw-py-3 lg:tw-p-4">
                    <div class="splide__arrows inner_arrows lg:tw-flex tw-mb-5">
                      <button class="splide__arrow splide__arrow--prev tw-mr-1 tw-p-1.5 tw-border tw-border-primary-500 disabled:tw-opacity-50 enabled:hover:tw-bg-primary-500 enabled:hover:tw-text-white" data-role="prev">
                        {% render 'icon-chevron-left' %}
                      </button>
                      <button
                        class="splide__arrow splide__arrow--next tw-p-1.5 tw-border tw-border-primary-500 disabled:tw-opacity-50 enabled:hover:tw-bg-primary-500 enabled:hover:tw-text-white"
                        data-role="next"
                        {% if forloop.last %}
                        disabled
                        {% endif %}>
                        {% render 'icon-chevron-right' %}
                      </button>
                    </div>


                    {% if block.settings.title != blank %}
                      <h2 class="tw-text-text-xl lg:tw-text-text-xl tw-font-heading tw-uppercase tw-leading-none tw-mb-3">{{ block.settings.title }}</h2>
                    {% endif %}
                    {% if block.settings.subtitle != blank %}
                      <h3 class="tw-text-md tw-font-medium tw-font-body tw-mb-5">{{ block.settings.subtitle }}</h3>
                    {% endif %}
                    {% if block.settings.content != blank %}
                      <div class="tw-mb-5">
                        {{ block.settings.content }}
                      </div>
                    {% endif %}

                    {% if block.settings.cta_label != blank %}
                      <a href="{{block.settings.cta_url}}" class="button button--primary tw-w-full lg:tw-w-fit !tw-border-0 tw-uppercase hover:tw-bg-secondary-200 hover:tw-text-primary-600">{{ block.settings.cta_label }}</a>
                    {% endif %}

                  </div>
                </div>

              </li>
            {%- endfor -%}
          </ul>
        </div>

      </div>

    </div>

  </div>
</div>


{% schema %}
  {
    "name": "Slide Banner",
    "tag": "section",
    "class": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 104,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 104,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "t:sections.slideshow.blocks.slide.name",
        "limit": 5,
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.slideshow.blocks.slide.settings.image.label"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "text",
            "id": "subtitle",
            "label": "Subtitle"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Content"
          },
          {
            "type": "url",
            "id": "cta_url",
            "label": "Button link"
          },
          {
            "type": "text",
            "id": "cta_label",
            "label": "Button label"
          }

        ]
      }
    ],
    "presets": [
      {
        "name": "Slide Banner",
        "blocks": [
          {
            "type": "slide"
          },
          {
            "type": "slide"
          }
        ]
      }
    ]
  }
{% endschema %}